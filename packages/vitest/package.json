{
  "name": "@straw-ai/vitest",
  "version": "0.0.1",
  "description": "Vitest matchers for LLM context regression tests",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --noEmit",
    "test": "pnpm --filter @straw-ai/sdk build && vitest run",
    "lint": "oxlint",
    "spellcheck": "cspell \"src/**/*.ts\""
  },
  "dependencies": {
    "@straw-ai/sdk": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "tsup": "^8.5.1",
    "typescript": "~5.8.3",
    "vitest": "^2.1.2"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  }
}
