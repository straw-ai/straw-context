{
  "name": "@straw-ai/cli",
  "version": "0.0.1",
  "description": "Context inspection and regression CLI for LLM requests",
  "license": "MIT",
  "bin": {
    "straw": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@straw-ai/context": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^12.20.55",
    "oxlint": "^1.58.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "typescript": "~5.8.3",
    "vitest": "^2.1.2"
  }
}
