{
  "name": "@straw-ai/sdk",
  "version": "0.0.1",
  "description": "Context Optimization SDK",
  "keywords": [
    "context",
    "json",
    "llm",
    "markdown",
    "minification",
    "prompt-engineering"
  ],
  "license": "MIT",
  "author": "Straw AI",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt --config ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "spellcheck": "cspell \"src/**/*.ts\"",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^4.1.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.58.0",
    "tsup": "^8.5.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.2"
  }
}
