{
  "name": "@straw-ai/sdk",
  "version": "0.0.1",
  "description": "Static analysis and regression testing for assembled LLM requests",
  "keywords": [
    "ai-agents",
    "context",
    "context-ci",
    "json",
    "llm",
    "markdown",
    "prompt-engineering",
    "regression-testing",
    "static-analysis"
  ],
  "license": "MIT",
  "author": "Straw AI",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -b --force",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt --config ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "spellcheck": "cspell \"src/**/*.ts\"",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "oxfmt": "^0.42.0",
    "oxlint": "^1.58.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "typescript": "~5.8.3",
    "vitest": "^2.1.2"
  }
}
