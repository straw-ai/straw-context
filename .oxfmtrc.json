{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortImports": {},
  "sortPackageJson": {},
  "ignorePatterns": ["**/dist/**", "**/build/**", "**/node_modules/**", "**/.next/**", "**/.turbo/**"]
}
